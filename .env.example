# /.env.example
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=change-this-to-a-long-random-secret

DB_HOST=db
DB_PORT=3306
DB_NAME=pantry_metrics
DB_USER=pantry_metrics
DB_PASS=pantry_metrics_password
DB_ROOT_PASS=rootpassword

SESSION_NAME=pantry_metrics_session

OIDC_ENABLED=true

OIDC_ISSUER=https://sso.rikben.nl/application/o/pantry-metrics/
OIDC_DISCOVERY_URL=https://sso.rikben.nl/application/o/pantry-metrics/.well-known/openid-configuration

OIDC_CLIENT_ID=pantry-metrics
OIDC_CLIENT_SECRET=xxxxxxxxxxxxxxxx

OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/auth/logged-out

OIDC_SCOPES=openid profile email
OIDC_SESSION_TTL=28800

OIDC_BOOTSTRAP_USER_ID=1
OIDC_ALLOW_EMAIL_LINK=false

SESSION_SECURE=false
SESSION_SAMESITE=Lax