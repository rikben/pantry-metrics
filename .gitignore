# /.gitignore
.env
/vendor/
/node_modules/
/storage/logs/*.log
/storage/cache/*
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
/database/.migration-state
.DS_Store
Thumbs.db
.idea/
.vscode/

# Production/runtime uploads
/public_html/uploads/products/*
!/public_html/uploads/products/.gitkeep

/public_html/uploads/recipes/*
!/public_html/uploads/recipes/.gitkeep

# Backups created by patch scripts
*.bak-*